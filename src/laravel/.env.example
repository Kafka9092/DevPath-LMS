APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://localhost:8089

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailserver
MAIL_PORT=25
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@devpath.local"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_AUTO_VERIFY=false
MAIL_CAPTURE_INBOX=inbox@devpath.local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

OLLAMA_HOST=http://nginx:80
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen3-coder:480b-cloud

HR_CONDUCT_ENABLED=true
SENIOR_PROGRAM_CARD_ENABLED=true
ADAPTIVE_TEST_CONTINUE_BAR_ENABLED=true
LESSON_LENIENT_REVIEW=false

# Kafka — асинхронная генерация адаптивного теста
KAFKA_BROKERS=kafka:9092
KAFKA_TEST_ASYNC=true
KAFKA_TEST_ASYNC_START=true
KAFKA_TEST_ASYNC_NEXT=true
KAFKA_TEST_ASYNC_FINISH=true
KAFKA_TEST_POLL_TIMEOUT=25
KAFKA_TEST_START_TOPIC=adaptive.test.start
KAFKA_TEST_NEXT_TOPIC=adaptive.test.next-question
KAFKA_TEST_FINISH_TOPIC=adaptive.test.finish
KAFKA_TEST_CONSUMER_GROUP=adaptive.test

# Kafka — асинхронная генерация уроков (контент, чат, проверка практики)
KAFKA_LESSON_ASYNC=true
KAFKA_LESSON_ASYNC_CONTENT=true
KAFKA_LESSON_ASYNC_CHAT=true
KAFKA_LESSON_ASYNC_REVIEW=true
KAFKA_LESSON_CONTENT_POLL_TIMEOUT=90
KAFKA_LESSON_CHAT_POLL_TIMEOUT=25
KAFKA_LESSON_REVIEW_POLL_TIMEOUT=45
KAFKA_LESSON_CONTENT_TOPIC=lesson.content.generate
KAFKA_LESSON_CHAT_TOPIC=lesson.mentor.chat
KAFKA_LESSON_REVIEW_TOPIC=lesson.practice.review
KAFKA_LESSON_CONSUMER_GROUP=lesson.workers

# Kafka — анализ кода и HR-собеседования
KAFKA_CODE_REVIEW_ASYNC=true
KAFKA_CODE_REVIEW_ASYNC_ANALYZE=true
KAFKA_CODE_REVIEW_POLL_TIMEOUT=60
KAFKA_CODE_REVIEW_TOPIC=chat.code-review.analyze
KAFKA_CODE_REVIEW_CONSUMER_GROUP=chat.code-review
KAFKA_HR_INTERVIEW_ASYNC=true
KAFKA_HR_INTERVIEW_ASYNC_REPLY=true
KAFKA_HR_INTERVIEW_ASYNC_CODE=true
KAFKA_HR_INTERVIEW_POLL_TIMEOUT=45
KAFKA_HR_INTERVIEW_TOPIC=chat.hr-interview.chat
KAFKA_HR_INTERVIEW_CONSUMER_GROUP=chat.hr-interview

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# OAuth — redirect URI строго https (сайт на порту 8089)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="https://localhost:8089/auth/github/callback"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="https://localhost:8089/auth/google/callback"

SONAR_HOST=http://sonarqube:9000
SONAR_TOKEN=
VITE_APP_NAME="${APP_NAME}"
VITE_DEV_SERVER_URL=https://localhost:8089
