<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="KAFKA_TEST_ASYNC" value="false"/>
        <env name="KAFKA_TEST_ASYNC_START" value="false"/>
        <env name="KAFKA_TEST_ASYNC_NEXT" value="false"/>
        <env name="KAFKA_TEST_ASYNC_FINISH" value="false"/>
        <env name="KAFKA_HR_INTERVIEW_ASYNC" value="false"/>
        <env name="KAFKA_HR_INTERVIEW_ASYNC_REPLY" value="false"/>
        <env name="KAFKA_HR_INTERVIEW_ASYNC_CODE" value="false"/>
        <env name="KAFKA_CODE_REVIEW_ASYNC" value="false"/>
        <env name="KAFKA_CODE_REVIEW_ASYNC_ANALYZE" value="false"/>
        <env name="KAFKA_LESSON_ASYNC" value="false"/>
        <env name="KAFKA_LESSON_ASYNC_CONTENT" value="false"/>
        <env name="KAFKA_LESSON_ASYNC_CHAT" value="false"/>
        <env name="KAFKA_LESSON_ASYNC_REVIEW" value="false"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="TURNSTILE_SITE_KEY" value="test-site-key"/>
        <env name="TURNSTILE_SECRET_KEY" value="test-secret-key"/>
        <env name="HR_CONDUCT_ENABLED" value="true"/>
    </php>
</phpunit>
